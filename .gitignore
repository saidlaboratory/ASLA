__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Generated local audit artifacts.
runs.parquet
runs_audit.json
# Results are committed: every generated document and every number in the README
# is rendered from these files, so a clone must be able to reproduce them without
# re-running multi-hour studies. Large intermediates are excluded individually
# below rather than by excluding the tree.
results/*
!results/abstention/
!results/adversarial/
!results/allocation/
!results/checkpoints/
!results/common_mode/
!results/confidence/
!results/consolidated/
!results/curvature/
!results/ensemble_check/
!results/external/
!results/first_audit/
!results/first_audit_v1_fixed_alpha_bounds/
!results/known_answer/
!results/resolution/
!results/signal_and_noise/
!results/task_b/
!results/theory/
!results/theory_v2/
.venv/
logs/*.out
logs/*.err
logs/*.log

# Raw public artifacts pulled by asla harvest-* (re-downloadable; never commit).
data/raw/

# Adversarial-audit intermediates (regenerable via audit/*.py).
results/adversarial/_*.md

# ColPret raw archive (64 MB, re-downloadable from github.com/IBM/ColPret)
data/raw/colpret/

